# OpenSSH server for redcrab's SSH tunnel tests. Throwaway credentials only:
# user `tunnel`, password `tunnelpass`, plus the key generated into
# tests/docker/.generated by scripts/test-env.sh (mounted at /generated).
FROM alpine:3.23

# openssh-client is for the health check, which logs in over SSH and forwards
# a PING to ssh-redis:6379.
RUN apk add --no-cache openssh-server openssh-client \
  && adduser -D -s /bin/sh tunnel \
  && echo 'tunnel:tunnelpass' | chpasswd \
  && rm -f /etc/ssh/ssh_host_*

COPY sshd_config /etc/ssh/sshd_config
COPY entrypoint.sh healthcheck.sh /usr/local/bin/

EXPOSE 22
ENTRYPOINT ["/bin/sh", "/usr/local/bin/entrypoint.sh"]
